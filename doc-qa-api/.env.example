APP_ENV=developement
APP_DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=8001

DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/docqa

JWT_SECRET_KEY=super-secret-jwt-key-replace-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
OLLAMA_TIMEOUT=120

CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=documents

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

CHUNK_SIZE=512
CHUNK_OVERLAP=64

TOP_K=8