APP_ENV=developement
APP_DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=8001

DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/docqa

JWT_SECRET_KEY=super-secret-jwt-key-replace-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
OLLAMA_TIMEOUT=120

CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=documents

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=mps
EMBEDDING_BATCH_SIZE=16

CHUNK_SIZE=1024
CHUNK_OVERLAP=128

TOP_K=8
MAX_CONTEXT_TOKENS=6000